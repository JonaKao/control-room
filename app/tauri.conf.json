{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Control Room",
  "mainBinaryName": "control-room",
  "version": "0.1.3",
  "identifier": "dev.agentic-ai-framework.control-room",
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "shortDescription": "A live view of what the coding agents in your projects are doing"
  }
}
